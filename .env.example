POSTGRES_USER=express_user
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=express_task_db
DATABASE_URL=postgresql://express_user:your_password_here@localhost:5432/express_task_db
PORT=5000

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=15m
JWT_ISSUER=express-task-api
JWT_AUDIENCE=express-task-client
BCRYPT_SALT_ROUNDS=12

# Optional Gmail password-reset delivery. Use a Gmail App Password, not the account password.
SMTP_USER=
SMTP_APP_PASSWORD=
APP_BASE_URL=http://localhost:5000

# Used only by npm run seed:admin. Remove the password after bootstrapping.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=
