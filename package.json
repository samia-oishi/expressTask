{
  "name": "express-task",
  "version": "1.0.0",
  "description": "REST API backend using Express, TypeScript, PostgreSQL and Drizzle ORM",
  "keywords": [
    "express",
    "typescript",
    "postgresql",
    "drizzle",
    "rest-api"
  ],
  "homepage": "https://github.com/samia-oishi/expressTask#readme",
  "bugs": {
