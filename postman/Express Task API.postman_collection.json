{
  "info": {
    "_postman_id": "cb6dd4d8-39ac-4299-90ec-cd95fc790a39",
    "name": "Express Task API",
    "description": "Account lifecycle and admin RBAC QA for the Express Task API. Import the supplied local environment, configure the seeded admin credentials, and run numbered folders in order.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.environment.get('runId')) {",
          "  const runId = `${Date.now()}-${Math.random().toString(16).slice(2, 8)}`;",
          "  pm.environment.set('runId', runId);",
          "  pm.environment.set('userEmail', `postman-${runId}@example.test`);",
          "}",
          "if (!pm.environment.get('targetUserId') && pm.environment.get('userId')) {",
          "  pm.environment.set('targetUserId', pm.environment.get('userId'));",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "jsonContentType",
      "value": "application/json"
    }
  ],
  "item": [
    {
      "name": "01 Setup and basic account QA",
      "description": "Creates one disposable user, signs in as that user and the seeded admin, and captures IDs/tokens for the RBAC folder.",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('API is healthy', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Signup rejects public role input",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "{{jsonContentType}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\",\n  \"displayName\": \"{{displayName}}\",\n  \"role\": \"admin\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/signup"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Role input is rejected', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Signup disposable user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "{{jsonContentType}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\",\n  \"displayName\": \"{{displayName}}\",\n  \"bio\": \"Created by the Postman QA collection\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/signup"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('User is created', () => pm.response.to.have.status(201));",
                  "var data = pm.response.json().data;",
                  "pm.test('Public signup assigns user role', () => pm.expect(data.user.role).to.eql('user'));",
                  "pm.environment.set('userId', data.user.id);",
                  "pm.environment.set('targetUserId', data.user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Signin disposable user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "{{jsonContentType}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/signin"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('User signs in', () => pm.response.to.have.status(200));",
                  "var data = pm.response.json().data;",
                  "pm.test('Signin returns user role', () => pm.expect(data.user.role).to.eql('user'));",
                  "pm.environment.set('userToken', data.accessToken);",
                  "pm.environment.set('userId', data.user.id);",
                  "pm.environment.set('targetUserId', data.user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get current user",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/v1/users/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Current user is returned', () => pm.response.to.have.status(200));",
                  "pm.test('Safe role is present', () => pm.expect(pm.response.json().data.user.role).to.eql('user'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get current profile",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/v1/users/me/profile"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Profile is returned', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update current profile",
          "request": {
            "method": "PATCH",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "{{jsonContentType}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"{{displayName}} Updated\",\n  \"bio\": \"Updated by Postman\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/users/me/profile"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Profile is updated', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Signin seeded admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "{{jsonContentType}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/signin",
            "description": "Set adminEmail/adminPassword in the environment first."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin signs in', () => pm.response.to.have.status(200));",
                  "var data = pm.response.json().data;",
                  "pm.test('Database role is admin', () => pm.expect(data.user.role).to.eql('admin'));",
                  "pm.environment.set('adminToken', data.accessToken);",
                  "pm.environment.set('adminUserId', data.user.id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Learning experiments - run after setup, before admin teardown",
      "description": "Run after folder 01 and before the destructive requests in folder 02. Each request asks one question about the API. Read the response and Test Results before continuing; the requests use the disposable user created in folder 01.",
      "item": [
        {
          "name": "Experiment 1 - Missing token returns 401",
          "description": "Question: what happens when a protected endpoint receives no Bearer token? Expected: 401 Unauthorized.",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/users/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Missing identity returns 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Experiment 2 - Normal user gets 403 on admin route",
          "description": "Question: the token is valid, but its user role is user. Expected: 403 Forbidden because identity is valid but permission is insufficient.",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/v1/admin/users"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Authenticated normal user is forbidden', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Experiment 3 - Signup cannot assign admin role",
          "description": "Question: can a public caller promote themselves by adding role to signup? Expected: 400 Bad Request; signup input is strict.",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "{{jsonContentType}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"learning-role-{{runId}}@example.test\",\n  \"password\": \"{{userPassword}}\",\n  \"displayName\": \"Role Injection Experiment\",\n  \"role\": \"admin\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/signup"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Public role assignment is rejected', () => { pm.response.to.have.status(400); pm.expect(pm.response.json().success).to.eql(false); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Experiment 4 - Profile rejects unsupported fields",
          "description": "Question: can profile editing change account permissions? Expected: 400 because role is not a profile field.",
          "request": {
            "method": "PATCH",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "{{jsonContentType}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"displayName\": \"{{displayName}}\", \"role\": \"admin\" }"
            },
            "url": "{{baseUrl}}/api/v1/users/me/profile"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Unsupported profile field is rejected', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Experiment 5 - Set profile bio baseline",
          "description": "Set a bio so the next request can test PATCH omission. Expected: 200 and the new bio is returned.",
          "request": {
            "method": "PATCH",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "{{jsonContentType}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"bio\": \"Bio baseline {{runId}}\" }"
            },
            "url": "{{baseUrl}}/api/v1/users/me/profile"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Bio baseline is saved', () => { pm.response.to.have.status(200); const bio = pm.response.json().data.profile.bio; pm.expect(bio).to.eql(`Bio baseline ${pm.environment.get('runId')}`); pm.environment.set('profileBioBefore', bio); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Experiment 6 - Omitted bio stays unchanged",
          "description": "PATCH only displayName and omit bio. Expected: the saved bio is unchanged; omitted is different from null.",
          "request": {
            "method": "PATCH",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "{{jsonContentType}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"displayName\": \"{{displayName}} Omitted Bio Test\" }"
            },
            "url": "{{baseUrl}}/api/v1/users/me/profile"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Omitted bio stays unchanged', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().data.profile.bio).to.eql(pm.environment.get('profileBioBefore')); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Experiment 7 - Null clears bio",
          "description": "Send bio: null. Expected: 200 and profile.bio becomes null.",
          "request": {
            "method": "PATCH",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "{{jsonContentType}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"bio\": null }"
            },
            "url": "{{baseUrl}}/api/v1/users/me/profile"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Explicit null clears bio', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().data.profile.bio).to.eql(null); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 Admin RBAC regression",
      "description": "Run after folder 01. Exercises all six admin endpoints, negative authorization, session invalidation, state conflicts, last-admin safeguards, and deletion.",
      "item": [
        {
          "name": "List users without authentication - 401",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/admin/users"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Authentication is required', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "List users as normal user - 403",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/v1/admin/users"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Normal user is forbidden', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "List users with pagination and filters",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/v1/admin/users?page=1&limit=20&search={{runId}}&role=user&status=active"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Filtered list succeeds', () => pm.response.to.have.status(200));",
                  "var data = pm.response.json().data;",
                  "pm.test('Pagination metadata is present', () => { pm.expect(data.pagination.page).to.eql(1); pm.expect(data.pagination.limit).to.eql(20); });",
                  "pm.test('Disposable user is returned', () => pm.expect(data.users.some(user => user.id === pm.environment.get('targetUserId'))).to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject limit over 100 - 400",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/v1/admin/users?limit=101"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Invalid limit is rejected', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get target user details",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/v1/admin/users/{{targetUserId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Target details are returned', () => pm.response.to.have.status(200));",
                  "pm.test('Security fields are absent', () => { const user = pm.response.json().data.user; pm.expect(user).not.to.have.property('passwordHash'); pm.expect(user).not.to.have.property('tokenVersion'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject invalid target UUID - 400",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/v1/admin/users/not-a-uuid"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Invalid UUID is rejected', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject admin self-target - 403",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/v1/admin/users/{{adminUserId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin cannot target self', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject invalid role - 400",
          "request": {
            "method": "PATCH",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "{{jsonContentType}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"role\": \"superadmin\" }"
            },
            "url": "{{baseUrl}}/api/v1/admin/users/{{targetUserId}}/role"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Unknown role is rejected', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Promote target to admin",
          "request": {
            "method": "PATCH",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "{{jsonContentType}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"role\": \"admin\" }"
            },
            "url": "{{baseUrl}}/api/v1/admin/users/{{targetUserId}}/role"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Target is promoted', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().data.user.role).to.eql('admin'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Old user token is invalid after promotion",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/v1/users/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Promotion invalidates session', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Signin promoted target",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "{{jsonContentType}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/signin"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Promoted target signs in as admin', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().data.user.role).to.eql('admin'); });",
                  "pm.environment.set('targetAdminToken', pm.response.json().data.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Demote target to user",
          "request": {
            "method": "PATCH",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
